# =============================================================================
# LADLI — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
SECRET_KEY=generate-a-strong-random-secret-key-here
FLASK_DEBUG=0
FLASK_ENV=production
FORCE_SECURE_COOKIES=true

# ---------------------------------------------------------------------------
# Database — PostgreSQL (AWS RDS)
# ---------------------------------------------------------------------------
# Option 1: Full connection URL (recommended)
DATABASE_URL=postgresql://user:password@hostname:5432/ladli_db

# Option 2: Individual parameters (used if DATABASE_URL is not set)
# PGHOST=your-rds-endpoint.amazonaws.com
# PGPORT=5432
# PGDATABASE=ladli_db
# PGUSER=ladli_app
# PGPASSWORD=your-database-password
# PGSSLMODE=require

# ---------------------------------------------------------------------------
# Admin Account (first-run only)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=admin@yourcompany.com

# ---------------------------------------------------------------------------
# AWS S3 — Attachment Storage
# ---------------------------------------------------------------------------
AWS_S3_BUCKET=your-ladli-attachments-bucket
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are read automatically by boto3.
# On EC2/ECS, prefer IAM roles instead of explicit keys.

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Number of trusted proxy hops (e.g. 1 for ALB, 2 for CloudFront+ALB)
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Gunicorn (optional overrides)
# ---------------------------------------------------------------------------
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
# GUNICORN_LOG_LEVEL=info
