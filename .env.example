# =============================================================================
# LADLI — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
SECRET_KEY=generate-a-strong-random-secret-key-here
FLASK_DEBUG=0
FLASK_ENV=production
FORCE_SECURE_COOKIES=true

# ---------------------------------------------------------------------------
# Database — PostgreSQL (AWS RDS)
# ---------------------------------------------------------------------------
# Option 1: Full connection URL (recommended)
DATABASE_URL=postgresql://user:password@hostname:5432/ladli_db

# Option 2: Individual parameters (used if DATABASE_URL is not set)
# PGHOST=your-rds-endpoint.amazonaws.com
# PGPORT=5432
# PGDATABASE=ladli_db
# PGUSER=ladli_app
# PGPASSWORD=your-database-password
# PGSSLMODE=require
# PGCONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# Admin Account (first-run only)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=admin@yourcompany.com

# ---------------------------------------------------------------------------
# AWS S3 — Attachment Storage
# ---------------------------------------------------------------------------
AWS_S3_BUCKET=your-ladli-attachments-bucket
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are read automatically by boto3.
# On EC2/ECS, prefer IAM roles instead of explicit keys.

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Number of trusted proxy hops (e.g. 1 for ALB, 2 for CloudFront+ALB)
TRUSTED_PROXY_COUNT=0
# Enable forwarding only after verifying the immediate proxy addresses.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Include the actual Render hostname as well as both custom domains before setting.
# ALLOWED_HOSTS=ladlilab.com,www.ladlilab.com,your-service.onrender.com
ALLOW_SECURITY_QUESTION_RECOVERY=false
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
PGSSLMODE=require

# ---------------------------------------------------------------------------
# Gunicorn (optional overrides)
# ---------------------------------------------------------------------------
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
# GUNICORN_LOG_LEVEL=info
